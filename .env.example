# The Well's read API (same values Strike Canopy uses)
WELL_API_URL=http://192.168.4.25:8092
WELL_API_SECRET=
# The optimizer's OWN Postgres (compose service "db"), never tasty-market-db
DATABASE_URL=postgres://optimizer:optimizer@db:5432/optimizer
# DayPack cache root (bind-mounted at /data in the container)
OPT_DATA_DIR=/data
LOG_LEVEL=warn
